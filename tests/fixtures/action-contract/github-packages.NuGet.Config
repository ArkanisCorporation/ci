<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="github.com-ArkanisCorporation" value="https://nuget.pkg.github.com/ArkanisCorporation/index.json" />
    <add key="lookalike" value="https://nuget.pkg.github.com.evil.example/ArkanisCorporation/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="github.com-ArkanisCorporation">
      <package pattern="Arkanis.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
